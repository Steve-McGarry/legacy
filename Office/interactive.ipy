import datetime

# Example epoch timestamp
epoch_timestamp = 1717422319489/1000  # This represents October 1, 2021

# Convert epoch to datetime
date_time = datetime.datetime.fromtimestamp(epoch_timestamp)
formatted_date = date_time.strftime('%Y-%m-%d')

# Print the result
print("Epoch:", epoch_timestamp)
print("Date and Time:", formatted_date)
